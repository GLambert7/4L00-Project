--- !u!114 &6646261640777849349
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4768144329575124439}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 267a4b499cbabcf4181060560b2e42e4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueBox
  dialogueLines:
  - speaker: Missie
    dialogue: "Finley! I\u2019m so glad you\u2019re okay- that thing covered this
      area in garbage!"
  - speaker: Finley
    dialogue: "I know, but don\u2019t worry- we\u2019ll get it dealt with! Will you
      help me?"
  - speaker: Missie
    dialogue: "Clean up our home? Of course- we\u2019ll show em who\u2019s boss."
  - speaker: Finley
    dialogue: Then let's get to it. Come with me-!
