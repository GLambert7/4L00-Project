<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Menus/DialogueBox/DialogueBox.uss?fileID=7433441132597879392&amp;guid=542eacb9b20723944a7170f523480a4c&amp;type=3#DialogueBox"/>
    <ui:VisualElement name="Root" style="flex-grow: 1; justify-content: flex-end; align-items: center;">
        <ui:VisualElement style="flex-grow: 0; height: 360px; width: 85%;">
            <ui:VisualElement name="DialogueBox" style="flex-grow: 1; margin-top: 45px; background-color: rgb(255, 250, 223); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; border-top-width: 10px; border-right-width: 10px; border-bottom-width: 10px; border-left-width: 10px; border-left-color: rgb(154, 207, 217); border-right-color: rgb(154, 207, 217); border-top-color: rgb(154, 207, 217); border-bottom-color: rgb(154, 207, 217); margin-bottom: 30px; margin-left: 30px; margin-right: 30px; justify-content: flex-end; align-items: center;">
                <ui:Label text="Lorem ipsum dolor sit amet consectetur adipiscing elit dolorum temporibus optio quos id sed est distinctio irure voluptate eu et optio atque sint dolor excepturi rerum et et omnis maxime dolorem consequat aliqua aute lorem fuga id anim dolore et est magna cupiditate anim libero adipiscing nisi incididunt exercitation id" name="Dialogue" class="dialogue-text"/>
            </ui:VisualElement>
            <ui:VisualElement name="NameCard" style="flex-grow: 1; position: absolute; width: 24%; height: 100px; background-color: rgb(154, 207, 217); top: 0; align-self: center; align-items: center; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px;">
                <ui:Label text="Name" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; font-size: 45px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
