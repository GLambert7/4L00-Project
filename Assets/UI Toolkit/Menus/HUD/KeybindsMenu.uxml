<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Universal%20Stylesheets/Universal.uss?fileID=7433441132597879392&amp;guid=26e9159df86912247bab5dc10a8e07d8&amp;type=3#Universal"/>
    <Style src="project://database/Assets/UI%20Toolkit/Menus/HUD/ParentHUD.uss?fileID=7433441132597879392&amp;guid=f3795cb378feac84a808e5721c831583&amp;type=3#ParentHUD"/>
    <ui:VisualElement name="Container" style="flex-grow: 0; width: 100%; height: 100%; justify-content: flex-end; align-items: flex-end; padding-top: 60px; padding-right: 60px; padding-bottom: 60px; padding-left: 60px;">
        <ui:VisualElement name="CompanionsInteract" style="flex-grow: 0;">
            <ui:VisualElement name="PlayerInteract" style="flex-grow: 0; padding-bottom: 46px; flex-direction: row-reverse;">
                <ui:VisualElement name="PlayerBtn" class="button-display" style="background-color: rgb(236, 97, 98); justify-content: center; flex-grow: 0; margin-right: 10px; margin-left: 10px;">
                    <ui:Label text="Q" class="btn-label" style="padding-top: 9px;"/>
                </ui:VisualElement>
                <ui:Label text="Interact" class="hud-text"/>
            </ui:VisualElement>
            <ui:VisualElement name="Span" style="flex-grow: 1; align-items: center;">
                <ui:VisualElement name="ButtonMapping" style="flex-grow: 0; width: auto; height: 149px; flex-direction: row; align-items: stretch;">
                    <ui:VisualElement class="btn-mapping-columns" style="flex-grow: 0; justify-content: flex-end;">
                        <ui:VisualElement name="DumboBtn" class="button-display" style="background-color: rgb(207, 143, 255); justify-content: center; flex-grow: 0;">
                            <ui:Label text="R" class="btn-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="btn-mapping-columns" style="flex-grow: 0; justify-content: flex-start;">
                        <ui:VisualElement name="VaquitaBtn" class="button-display" style="background-color: rgb(255, 136, 85); bottom: auto; flex-grow: 0;">
                            <ui:Label text="E" class="btn-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="btn-mapping-columns" style="flex-grow: 0; justify-content: flex-end;">
                        <ui:VisualElement name="EelBtn" class="button-display" style="background-color: rgb(86, 209, 142); flex-grow: 0;">
                            <ui:Label text="T" class="btn-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
