<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Universal%20Stylesheets/Universal.uss?fileID=7433441132597879392&amp;guid=26e9159df86912247bab5dc10a8e07d8&amp;type=3#Universal"/>
    <Style src="project://database/Assets/UI%20Toolkit/Menus/HUD/ParentHUD.uss?fileID=7433441132597879392&amp;guid=f3795cb378feac84a808e5721c831583&amp;type=3#ParentHUD"/>
    <ui:VisualElement name="Container" style="flex-grow: 0; width: 100%; height: 100%; justify-content: flex-end; align-items: flex-end; padding-top: 60px; padding-right: 60px; padding-bottom: 60px; padding-left: 60px;">
        <ui:VisualElement name="CompanionsInteract" style="flex-grow: 0;">
            <ui:VisualElement name="Dash" style="flex-grow: 0; padding-bottom: 0; flex-direction: row-reverse; padding-top: 0; padding-right: 0; padding-left: 0; margin-bottom: 10px;">
                <ui:VisualElement name="DashBtn" class="button-display" style="background-color: rgb(60, 122, 209); justify-content: center; flex-grow: 0; margin-right: 10px; margin-left: 10px;">
                    <ui:Label text="Ctl" class="btn-label" style="padding-top: 9px; font-size: 30px;"/>
                </ui:VisualElement>
                <ui:Label text="Dash" class="hud-text"/>
            </ui:VisualElement>
            <ui:VisualElement name="PlayerInteract" style="flex-grow: 0; padding-bottom: 0; flex-direction: row-reverse; margin-bottom: 0;">
                <ui:VisualElement name="PlayerBtn" class="button-display" style="background-color: rgb(209, 69, 60); justify-content: center; flex-grow: 0; margin-right: 10px; margin-left: 10px;">
                    <ui:Label text="Q" class="btn-label" style="padding-top: 9px;"/>
                </ui:VisualElement>
                <ui:Label text="Read" class="hud-text"/>
            </ui:VisualElement>
            <ui:VisualElement name="Span" style="flex-grow: 0; align-items: flex-end;">
                <ui:VisualElement name="ButtonMapping" style="flex-grow: 0; width: auto; height: 203px; flex-direction: row; align-items: stretch;">
                    <ui:VisualElement class="btn-mapping-columns" style="flex-grow: 0; justify-content: flex-start;">
                        <ui:Image source="project://database/Assets/UI%20Toolkit/Images/VaquitaIcon.png?fileID=2800000&amp;guid=cf1df15697dcad3419144d21ab9e1413&amp;type=3#VaquitaIcon" style="width: 70px;"/>
                        <ui:VisualElement name="VaquitaBtn" class="button-display" style="background-color: rgb(253, 158, 27); bottom: auto; flex-grow: 0;">
                            <ui:Label text="E" class="btn-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="btn-mapping-columns" style="flex-grow: 0; justify-content: flex-end;">
                        <ui:Image source="project://database/Assets/UI%20Toolkit/Images/DumboIcon.png?fileID=2800000&amp;guid=aaf104f04f7e415409e0878021dbc25d&amp;type=3#DumboIcon" style="width: 70px;"/>
                        <ui:VisualElement name="DumboBtn" class="button-display" style="background-color: rgb(209, 38, 115); justify-content: center; flex-grow: 0;">
                            <ui:Label text="R" class="btn-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="btn-mapping-columns" style="flex-grow: 0; justify-content: flex-end;">
                        <ui:Image source="project://database/Assets/UI%20Toolkit/Images/EelIcon.png?fileID=2800000&amp;guid=2338b9a5ef4f1b54eb831ec5286ed5f9&amp;type=3#EelIcon" style="width: 70px;"/>
                        <ui:VisualElement name="EelBtn" class="button-display" style="background-color: rgb(0, 131, 136); flex-grow: 0;">
                            <ui:Label text="T" class="btn-label"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
