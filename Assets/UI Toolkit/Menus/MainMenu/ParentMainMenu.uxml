<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="CreditsMenu" src="project://database/Assets/UI%20Toolkit/Menus/MainMenu/CreditsMenu.uxml?fileID=9197481963319205126&amp;guid=6dc9377575cbc3e42bcef0a1bd77dee3&amp;type=3#CreditsMenu"/>
    <ui:Template name="MainMenu" src="project://database/Assets/UI%20Toolkit/Menus/MainMenu/TitleMenu.uxml?fileID=9197481963319205126&amp;guid=d88450363579bac4aba77411b9378217&amp;type=3#TitleMenu"/>
    <ui:Template name="OptionsMenu" src="project://database/Assets/UI%20Toolkit/Menus/MainMenu/OptionsMenu.uxml?fileID=9197481963319205126&amp;guid=ef9039da71c0a1b41a94021262cdb181&amp;type=3#OptionsMenu"/>
    <Style src="project://database/Assets/UI%20Toolkit/Universal%20Stylesheets/Universal.uss?fileID=7433441132597879392&amp;guid=26e9159df86912247bab5dc10a8e07d8&amp;type=3#Universal"/>
    <Style src="project://database/Assets/UI%20Toolkit/Menus/MainMenu/MainMenu.uss?fileID=7433441132597879392&amp;guid=036d353d9df5b464394d7c2925c8e7c4&amp;type=3#MainMenu"/>
    <ui:VisualElement name="Root" style="flex-grow: 1;">
        <ui:Instance template="CreditsMenu" name="CreditsMenu"/>
        <ui:Instance template="OptionsMenu" name="OptionsMenu" class="root"/>
        <ui:Instance template="MainMenu" name="TitleMenu" class="root"/>
        <ui:VisualElement name="HelpText" style="flex-grow: 0; position: absolute; top: 0; right: 0; align-items: flex-end; padding-top: 30px; padding-right: 3%;">
            <ui:Label text="NOTE: All unfinished menu options will have an asterisk* next to them" name="Asterisk" style="font-size: 20px; -unity-font-style: bold; color: rgb(63, 63, 63);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
