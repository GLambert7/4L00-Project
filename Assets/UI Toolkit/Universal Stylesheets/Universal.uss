.centered-container {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.heading-text {
    -unity-text-align: middle-center;
    align-items: center;
    -unity-font-style: bold;
    font-size: 85px;
    color: rgb(56, 156, 168);
    text-shadow: 5px 2.5px 0 rgb(140, 228, 238);
}

.subheading-text {
    -unity-font-style: normal;
    font-size: 50px;
    color: rgb(56, 156, 168);
}

.heading-container {
    height: auto;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    padding-bottom: 75px;
}

.root {
    position: absolute;
    width: 100%;
    height: 100%;
}

.background {
    background-color: rgb(255, 252, 239);
    padding-top: 100px;
    padding-bottom: 100px;
    padding-right: 100px;
    padding-left: 100px;
}

.body-text {
    -unity-font-style: normal;
    font-size: 46px;
    color: rgb(56, 156, 168);
}

